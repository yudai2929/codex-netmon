{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "codex-netmon"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "Wi-Fi usage attributed to Codex processes and commands launched by Codex, measured with macOS nettop. Change the time range in the upper right. Zero can mean no measurement in that range.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Total Wi-Fi usage",
          "description": "Bytes sent and received by Codex processes and their commands over the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(increase(codex_wifi_received_bytes_total[$__range])) or vector(0)) + (sum(increase(codex_wifi_sent_bytes_total[$__range])) or vector(0))",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": {
                "graphMode": "area",
                "colorMode": "none",
                "justifyMode": "auto",
                "textMode": "auto",
                "wideLayout": true,
                "showPercentChange": false,
                "reduceOptions": {
                  "calcs": []
                },
                "percentChangeColorMode": "standard",
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decbytes",
                  "noValue": "No measurements"
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-10": {
        "kind": "Panel",
        "spec": {
          "id": 10,
          "title": "Traffic over time by source",
          "description": "Bytes sent and received in each interval, split by source. Historical unclassified traffic is included with Codex processes.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(increase(codex_wifi_received_bytes_total{process_kind!=\"command\"}[$__rate_interval])) or vector(0)) + (sum(increase(codex_wifi_sent_bytes_total{process_kind!=\"command\"}[$__rate_interval])) or vector(0))",
                        "instant": false,
                        "legendFormat": "Codex processes",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(increase(codex_wifi_received_bytes_total{process_kind=\"command\"}[$__rate_interval])) or vector(0)) + (sum(increase(codex_wifi_sent_bytes_total{process_kind=\"command\"}[$__rate_interval])) or vector(0))",
                        "instant": false,
                        "legendFormat": "Commands launched by Codex",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decbytes",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-11": {
        "kind": "Panel",
        "spec": {
          "id": 11,
          "title": "Usage breakdown",
          "description": "Wi-Fi bytes by source and direction over the selected time range. All Codex traffic is the sum of Codex processes and commands. Historical unclassified traffic is included with Codex processes.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "label_replace(label_replace(((sum(increase(codex_wifi_received_bytes_total[$__range])) or vector(0)) + (sum(increase(codex_wifi_sent_bytes_total[$__range])) or vector(0))), \"source\", \"All Codex traffic\", \"__name__\", \".*\"), \"direction\", \"Total\", \"__name__\", \".*\") or label_replace(label_replace((sum(increase(codex_wifi_received_bytes_total[$__range])) or vector(0)), \"source\", \"All Codex traffic\", \"__name__\", \".*\"), \"direction\", \"Received\", \"__name__\", \".*\") or label_replace(label_replace((sum(increase(codex_wifi_sent_bytes_total[$__range])) or vector(0)), \"source\", \"All Codex traffic\", \"__name__\", \".*\"), \"direction\", \"Sent\", \"__name__\", \".*\") or label_replace(label_replace(((sum(increase(codex_wifi_received_bytes_total{process_kind!=\"command\"}[$__range])) or vector(0)) + (sum(increase(codex_wifi_sent_bytes_total{process_kind!=\"command\"}[$__range])) or vector(0))), \"source\", \"Codex processes\", \"__name__\", \".*\"), \"direction\", \"Total\", \"__name__\", \".*\") or label_replace(label_replace((sum(increase(codex_wifi_received_bytes_total{process_kind!=\"command\"}[$__range])) or vector(0)), \"source\", \"Codex processes\", \"__name__\", \".*\"), \"direction\", \"Received\", \"__name__\", \".*\") or label_replace(label_replace((sum(increase(codex_wifi_sent_bytes_total{process_kind!=\"command\"}[$__range])) or vector(0)), \"source\", \"Codex processes\", \"__name__\", \".*\"), \"direction\", \"Sent\", \"__name__\", \".*\") or label_replace(label_replace(((sum(increase(codex_wifi_received_bytes_total{process_kind=\"command\"}[$__range])) or vector(0)) + (sum(increase(codex_wifi_sent_bytes_total{process_kind=\"command\"}[$__range])) or vector(0))), \"source\", \"Commands launched by Codex\", \"__name__\", \".*\"), \"direction\", \"Total\", \"__name__\", \".*\") or label_replace(label_replace((sum(increase(codex_wifi_received_bytes_total{process_kind=\"command\"}[$__range])) or vector(0)), \"source\", \"Commands launched by Codex\", \"__name__\", \".*\"), \"direction\", \"Received\", \"__name__\", \".*\") or label_replace(label_replace((sum(increase(codex_wifi_sent_bytes_total{process_kind=\"command\"}[$__range])) or vector(0)), \"source\", \"Commands launched by Codex\", \"__name__\", \".*\"), \"direction\", \"Sent\", \"__name__\", \".*\")",
                        "format": "table",
                        "instant": true,
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "groupingToMatrix",
                  "spec": {
                    "options": {
                      "columnField": "direction",
                      "rowField": "source",
                      "valueField": "Value"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "renameByName": {
                        "source\\direction": "Source"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "",
            "spec": {
              "options": {
                "frameIndex": 0,
                "showHeader": true,
                "showTypeIcons": false,
                "footer": {
                  "show": false,
                  "reducer": null,
                  "countRows": false
                },
                "cellHeight": "sm"
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decbytes",
                  "custom": {
                    "align": "auto",
                    "inspect": false
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-7": {
        "kind": "Panel",
        "spec": {
          "id": 7,
          "title": "Wi-Fi transfer rate",
          "description": "Receive and send rate for Codex processes and their commands combined.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(codex_wifi_received_bytes_total[1m])) or vector(0)",
                        "instant": false,
                        "legendFormat": "Received",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(rate(codex_wifi_sent_bytes_total[1m])) or vector(0)",
                        "instant": false,
                        "legendFormat": "Sent",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "Bps",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-8": {
        "kind": "Panel",
        "spec": {
          "id": 8,
          "title": "Wi-Fi usage by program",
          "description": "Share of Wi-Fi bytes sent and received by executable in the selected range, including commands launched by Codex.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum by (process) (increase(codex_wifi_received_bytes_total[$__range])) + sum by (process) (increase(codex_wifi_sent_bytes_total[$__range]))) \u003e 0",
                        "instant": true,
                        "legendFormat": "{{process}}",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "piechart",
            "version": "",
            "spec": {
              "options": {
                "pieType": "pie",
                "tooltip": {
                  "mode": "",
                  "sort": ""
                },
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ]
                },
                "legend": {
                  "values": [
                    "value",
                    "percent"
                  ],
                  "displayMode": "table",
                  "placement": "right",
                  "showLegend": true,
                  "calcs": []
                },
                "orientation": ""
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decbytes",
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-9": {
        "kind": "Panel",
        "spec": {
          "id": 9,
          "title": "Traffic over time by direction",
          "description": "Estimated received, sent, and total bytes in each interval. The interval adapts to the selected time range.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(increase(codex_wifi_received_bytes_total[$__rate_interval])) or vector(0)",
                        "instant": false,
                        "legendFormat": "Received",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(increase(codex_wifi_sent_bytes_total[$__rate_interval])) or vector(0)",
                        "instant": false,
                        "legendFormat": "Sent",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "(sum(increase(codex_wifi_received_bytes_total[$__rate_interval])) or vector(0)) + (sum(increase(codex_wifi_sent_bytes_total[$__rate_interval])) or vector(0))",
                        "instant": false,
                        "legendFormat": "Total",
                        "range": true
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": {
                "legend": {
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true,
                  "calcs": []
                },
                "tooltip": {
                  "mode": "",
                  "sort": ""
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "decbytes",
                  "min": 0,
                  "custom": {}
                },
                "overrides": []
              }
            }
          }
        }
      }
    },
